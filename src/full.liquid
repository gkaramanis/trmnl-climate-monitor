<div class="view view--full">
  <div class="layout">
    <div class="grid grid--cols-3">

      <div class="col--span-1 flex flex--col flex--evenly">
        <div class="flex flex--col">
          <span class="label">Today's high</span>
          <span class="value value--base">{{ high_predicted }}{{ units }}</span>
        </div>
        <div class="flex flex--col">
          <span class="label">{{ normal_window }} avg high</span>
          <span class="value value--small">{{ high_normal }}{{ units }}</span>
        </div>
        <div class="flex flex--col">
          <span class="label">Anomaly</span>
          <span class="value value--small">{{ high_anomaly_str }}</span>
        </div>
      </div>

      <div class="col--span-2">{{ svg_full }}</div>

    </div>
  </div>

  <div class="title_bar">
    <span class="title">Climate Monitor · {{ location }}</span>
    <span class="instance">{{ year }} vs {{ normal_window }}</span>
  </div>
</div>
